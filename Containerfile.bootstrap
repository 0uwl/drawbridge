# Serves scripts/ztp-base.py over plain, unauthenticated HTTP for the one
# fetch that structurally can't use TLS: DHCP Option 67's boot-file-name
# fetch happens before any ZTP script code has run, so there's no way to
# pre-establish trust for a self-signed cert ahead of it — confirmed
# against a real C9200CX (see docs/decisions.md,
# "HTTPS cert trust on C9200CX"). Everything the script itself does
# afterward still goes over HTTPS as before; this container exists purely
# to break that one chicken-and-egg fetch.
#
# Deliberately its own container, not folded into drawbridge-nginx even
# though nginx could easily serve a static file too: ZTP script serving is
# core, non-optional functionality (devices cannot provision at all
# without it), whereas drawbridge-nginx (TLS termination) and
# drawbridge-rsyslog (syslog collection) are both meant to be independently
# skippable — an operator bringing their own reverse proxy just doesn't
# start drawbridge-nginx (see docs/deployment.md, "TLS"). Folding this
# container's job into one of the optional ones would mean turning off an
# optional feature silently breaks a required one. See v0-3-2.md.
#
# Not COPYed into the image: scripts/ztp-base.py has deployment-specific
# constants (DRAWBRIDGE_HOST, DRAWBRIDGE_CA_CERT_PEM) every operator must
# hand-edit before the script is usable against real hardware — baking a
# copy into the image would mean rebuilding/republishing a custom image
# just to change those, instead of editing one file on the host. Served
# from a bind-mount of the same files/scripts directory install.sh seeds
# on first install (see quadlet/drawbridge-bootstrap.container) — there is
# still exactly one ZTP script, just editable in place rather than fixed
# at build time.
#
# busybox:musl, not alpine: no package manager, no apk index, nothing but
# the busybox multi-call binary itself (~1.8MB total image) — httpd is one
# of its built-in applets, so there's nothing to `apk add` at all. This is
# explicitly the smallest-possible image for this one job, not a general
# "small base" default the way Containerfile.rsyslog's Alpine choice is.
FROM busybox:musl

RUN adduser -D -u 1000 bootstrap
USER bootstrap

# Informational only, same posture as the other Containerfiles.
EXPOSE 8090

# -f: foreground (this container's only process, no supervisor).
# -h /scripts: matches quadlet/drawbridge-bootstrap.container's read-only
# mount of files/scripts.
ENTRYPOINT ["httpd", "-f", "-v", "-p", "8090", "-h", "/scripts"]
