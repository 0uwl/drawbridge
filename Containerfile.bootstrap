# Serves scripts/ztp-base.py, baked into the image at build time, over
# plain, unauthenticated HTTP for the one fetch that structurally can't use
# TLS: DHCP Option 67's boot-file-name fetch happens before any ZTP script
# code has run, so there's no way to pre-establish trust for a self-signed
# cert ahead of it — confirmed against a real C9200CX (see docs/decisions.md,
# "HTTPS cert trust on C9200CX"). Everything the script itself does
# afterward still goes over HTTPS as before; this container exists purely
# to break that one chicken-and-egg fetch.
#
# busybox:musl, not alpine: no package manager, no apk index, nothing but
# the busybox multi-call binary itself (~1.8MB total image) — httpd is one
# of its built-in applets, so there's nothing to `apk add` at all. This is
# explicitly the smallest-possible image for this one job, not a general
# "small base" default the way Containerfile.rsyslog's Alpine choice is.
FROM busybox:musl

RUN adduser -D -u 1000 bootstrap
COPY scripts/ztp-base.py /scripts/ztp-base.py
USER bootstrap

# Informational only, same posture as the other two Containerfiles.
EXPOSE 8090

# -f: foreground (this container's only process, no supervisor).
# -h /scripts: serves the single file COPYed in above. No volume mount —
# there is exactly one ZTP script now (see docs/decisions.md, "Facts-first
# provisioning is deferred, not rejected"), versioned with the image
# rather than admin-uploaded, so there's nothing to bind-mount at runtime.
ENTRYPOINT ["httpd", "-f", "-v", "-p", "8090", "-h", "/scripts"]
