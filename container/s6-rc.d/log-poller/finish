#!/usr/bin/env bash
# gunicorn, rsyslog, and log-poller are all expected to run for the
# container's entire lifetime. Without this, s6 just respawns a crashed
# one forever while podman/systemd keeps reporting the container as
# healthy - a broken service (e.g. a missing SECRET_KEY) would crash-loop
# invisibly rather than being obvious. Exiting here (any exit reason, not
# just crashes - none of these three are ever expected to exit on their
# own) brings the whole container down instead, loudly, with the failed
# service's own exit code. See docs/logging.md.
set -eu
if [ "$1" -eq 256 ]; then
    exitcode=$((128 + $2))
else
    exitcode="$1"
fi
echo "$exitcode" > /run/s6-linux-init-container-results/exitcode
exec /run/s6/basedir/bin/halt
