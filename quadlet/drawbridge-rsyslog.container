# Pod member — see quadlet/drawbridge.pod for the pod-level settings
# shared with drawbridge.container (PublishPort=, UserNS=) and for
# install/host-prep instructions. See docs/logging.md for the design this
# container is part of.

[Unit]
Description=Drawbridge device syslog collector

[Container]
Image=ghcr.io/0uwl/drawbridge-rsyslog:latest
ContainerName=drawbridge-rsyslog
Pod=drawbridge.pod

# Read-only, just for Drawbridge's TLS cert — container/rsyslog-drawbridge.conf's
# omhttp action needs it as tls.cacert to verify the connection to
# https://127.0.0.1:8080 inside the pod's shared network namespace. No
# separate volume for rsyslog's own state: workDirectory is /tmp (Tmpfs=
# below), and -i NONE (Containerfile.rsyslog's ENTRYPOINT) means no pid
# file is ever written.
Volume=%h/.local/share/drawbridge/data:/app/data:ro,Z

ReadOnly=true
Tmpfs=/tmp

[Service]
Restart=on-failure
