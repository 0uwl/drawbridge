# Pod member — see quadlet/drawbridge.pod for the pod-level settings
# shared with drawbridge.container (PublishPort=, UserNS=) and for
# install/host-prep instructions. See docs/logging.md for the design this
# container is part of.

[Unit]
Description=Drawbridge device syslog collector

[Container]
Image=ghcr.io/0uwl/drawbridge-rsyslog:latest
ContainerName=drawbridge-rsyslog
Pod=drawbridge.pod

# No volume mount at all: this container never touches Drawbridge's data
# directory. It doesn't need the TLS cert — its omhttp actions talk plain
# HTTP to Gunicorn's internal-only port now, no TLS on that hop at all
# (see container/rsyslog-drawbridge.conf, v0-3-2.md) — or its own
# persistent state — workDirectory is /tmp (Tmpfs= below), and -i NONE
# (Containerfile.rsyslog's ENTRYPOINT) means no pid file is ever written.

ReadOnly=true
Tmpfs=/tmp

[Service]
Restart=on-failure
